# Copy to .env.local for local dev.
# For Cloudflare Workers: NEXT_PUBLIC_* vars are inlined at build time, so they
# must be present in the environment when running `npm run build:worker`.
# The rest are runtime secrets — set with `wrangler secret put <NAME>` or in
# the Cloudflare dashboard (see docs/DEPLOY-cloudflare.md).
# NEVER commit a real .env.local — .gitignore already excludes .env*.

# DeepSeek API key (server-side only). Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Supabase (public anon key is safe to expose; the app uses RLS / the allowed_users table)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NextAuth
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret the Chrome extension sends as x-api-key
EXTENSION_API_KEY=
