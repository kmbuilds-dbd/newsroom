# Copy to .env.local for local dev, or set these in the Vercel dashboard.
# NEVER commit a real .env.local — .gitignore already excludes .env*.

# DeepSeek API key (server-side only). Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Supabase (public anon key is safe to expose; the app uses RLS / the allowed_users table)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NextAuth
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret the Chrome extension sends as x-api-key
EXTENSION_API_KEY=
